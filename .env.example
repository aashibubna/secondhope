# Copy to .env.local and fill in from Firebase console →
# Project settings → General → Your apps → Web app → SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to true to use the local Firebase emulators instead (no project needed).
VITE_USE_EMULATORS=false

# Optional prefix for Firestore collection names (e.g. sh_ → sh_users, sh_jobs).
# Use it when sharing a Firebase project with another app; leave empty for a dedicated project.
VITE_COLLECTION_PREFIX=
